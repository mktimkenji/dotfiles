# ============================================================
# bootstrap.env — user configuration for the bootstrap script
# Copy this file to bootstrap.env and fill in the values.
# bootstrap.env is gitignored and never committed.
# ============================================================

# WSL distro name (must match exactly what Microsoft publishes)
# Check available names with: wsl --list --online
WSL_DISTRO=FedoraLinux-44

# Username and password to create inside the WSL distro
WSL_USERNAME=yourname
WSL_PASSWORD=yourpassword

# Git identity (used inside WSL)
GIT_NAME=Your Name
GIT_EMAIL=your@email.com
